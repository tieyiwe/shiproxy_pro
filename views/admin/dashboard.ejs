<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>
<main class="page">
  <div class="page-head">
    <div>
      <h1><%= t('admin.dashboard_title') %></h1>
      <p class="page-head-sub">
        <%= t('dashboard.welcome', { name: currentUser.name }) %>
        &middot; <%= t('admin.stat_users') %>: <strong><%= stats.totalUsers %></strong>
      </p>
    </div>
  </div>

  <nav class="admin-subnav">
    <a href="/admin/users" class="btn btn-ghost btn-sm"><%= t('admin.section_users') %></a>
    <a href="/admin/containers" class="btn btn-ghost btn-sm"><%= t('admin.section_containers') %></a>
    <a href="/admin/packages" class="btn btn-ghost btn-sm"><%= t('admin.section_packages') %></a>
    <a href="/admin/teams" class="btn btn-ghost btn-sm"><%= t('admin.section_teams') %></a>
  </nav>

  <div class="stat-grid">
    <div class="stat-tile">
      <div class="stat-tile-top">
        <span class="stat-tile-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20c0-3.6 3.4-6.2 7.5-6.2s7.5 2.6 7.5 6.2"/></svg>
        </span>
        <span class="stat-tile-label"><%= t('admin.stat_users') %></span>
      </div>
      <div class="stat-tile-value"><%= stats.totalUsers %></div>
      <div class="stat-tile-foot">
        <span class="badge badge-tier-info"><%= t('admin.stat_signups_7d', { count: stats.signups7d }) %></span>
        <span class="badge badge-tier-neutral"><%= t('admin.stat_signups_30d', { count: stats.signups30d }) %></span>
      </div>
    </div>

    <div class="stat-tile">
      <div class="stat-tile-top">
        <span class="stat-tile-icon stat-tile-icon-teal" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="11" rx="1.6"/><path d="M3 12.5h18M9 8v11M15 8v11"/></svg>
        </span>
        <span class="stat-tile-label"><%= t('admin.stat_containers') %></span>
      </div>
      <div class="stat-tile-value"><%= stats.totalContainers %></div>
      <% if (stats.containersByStatus.length > 0) { %>
        <div class="stat-tile-foot">
          <% stats.containersByStatus.forEach(function(row) { %>
            <span class="badge badge-tier-<%= statusTier(row.status) %>"><%= t('status.' + row.status) %>: <%= row.count %></span>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="stat-tile">
      <div class="stat-tile-top">
        <span class="stat-tile-icon stat-tile-icon-accent" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8l-9-5-9 5v8l9 5z"/><path d="m3.3 7.5 8.7 5 8.7-5M12 12.5V21"/></svg>
        </span>
        <span class="stat-tile-label"><%= t('admin.stat_packages') %></span>
      </div>
      <div class="stat-tile-value"><%= stats.totalPackages %></div>
      <% if (stats.packagesByStatus.length > 0) { %>
        <div class="stat-tile-foot">
          <% stats.packagesByStatus.forEach(function(row) { %>
            <span class="badge badge-tier-<%= statusTier(row.status) %>"><%= t('packages.status_' + row.status) %>: <%= row.count %></span>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="stat-tile">
      <div class="stat-tile-top">
        <span class="stat-tile-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19c0-3 2.5-5.2 5.5-5.2s5.5 2.2 5.5 5.2"/><path d="M16.5 5.3a3.2 3.2 0 0 1 0 5.9M18 13.9c2 .7 3.4 2.6 3.4 5.1"/></svg>
        </span>
        <span class="stat-tile-label"><%= t('admin.stat_teams') %></span>
      </div>
      <div class="stat-tile-value"><%= stats.totalTeams %></div>
    </div>

    <div class="stat-tile">
      <div class="stat-tile-top">
        <span class="stat-tile-icon stat-tile-icon-teal" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11.5a7.5 7.5 0 0 1-10.9 6.7L4 19.5l1.4-4.8A7.5 7.5 0 1 1 20 11.5z"/></svg>
        </span>
        <span class="stat-tile-label"><%= t('admin.stat_conversations') %></span>
      </div>
      <div class="stat-tile-value"><%= stats.totalConversations %></div>
    </div>

    <div class="stat-tile">
      <div class="stat-tile-top">
        <span class="stat-tile-icon stat-tile-icon-accent" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3.6 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8-4.3-4.1 5.9-.9z"/></svg>
        </span>
        <span class="stat-tile-label"><%= t('admin.stat_ratings') %></span>
      </div>
      <div class="stat-tile-value"><%= stats.totalRatings %></div>
    </div>

    <div class="stat-tile">
      <div class="stat-tile-top">
        <span class="stat-tile-icon stat-tile-icon-success" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
        </span>
        <span class="stat-tile-label"><%= t('admin.stat_unread_notifications') %></span>
      </div>
      <div class="stat-tile-value"><%= stats.unreadNotifications %></div>
    </div>
  </div>

  <section class="panel">
    <div class="panel-head">
      <h2 class="panel-title"><%= t('nav.manage') %></h2>
    </div>
    <div class="quick-links">
      <a class="quick-link" href="/admin/users">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20c0-3.6 3.4-6.2 7.5-6.2s7.5 2.6 7.5 6.2"/></svg>
        <%= t('admin.users_title') %>
        <span class="chev" aria-hidden="true">&rsaquo;</span>
      </a>
      <a class="quick-link" href="/admin/containers">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="11" rx="1.6"/><path d="M3 12.5h18M9 8v11M15 8v11"/></svg>
        <%= t('admin.containers_title') %>
        <span class="chev" aria-hidden="true">&rsaquo;</span>
      </a>
      <a class="quick-link" href="/admin/packages">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8l-9-5-9 5v8l9 5z"/><path d="m3.3 7.5 8.7 5 8.7-5M12 12.5V21"/></svg>
        <%= t('admin.packages_title') %>
        <span class="chev" aria-hidden="true">&rsaquo;</span>
      </a>
      <a class="quick-link" href="/admin/teams">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19c0-3 2.5-5.2 5.5-5.2s5.5 2.2 5.5 5.2"/><path d="M16.5 5.3a3.2 3.2 0 0 1 0 5.9M18 13.9c2 .7 3.4 2.6 3.4 5.1"/></svg>
        <%= t('admin.teams_title') %>
        <span class="chev" aria-hidden="true">&rsaquo;</span>
      </a>
    </div>
  </section>
</main>
<%- include('../partials/bottom-nav') %>
<%- include('../partials/scripts') %>
