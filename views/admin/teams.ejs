<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>
<main class="page">
  <p><a href="/admin" class="back-link">&larr; <%= t('admin.dashboard_title') %></a></p>
  <div class="page-header">
    <h1><%= t('admin.teams_title') %></h1>
  </div>

  <% if (teams.length === 0) { %>
    <p class="empty-state"><%= t('admin.no_teams_found') %></p>
  <% } else { %>
    <% teams.forEach(function(team) { %>
      <div class="card">
        <div class="page-header">
          <h2><%= team.name %></h2>
          <span class="badge badge-tier-neutral"><%= t('admin.plan_' + team.plan) %></span>
        </div>
        <p class="muted"><%= t('admin.team_owner') %>: <%= team.owner_name %> (<%= team.owner_email %>)</p>
        <% if (team.members.length === 0) { %>
          <p class="muted"><%= t('team.no_team_yet') %></p>
        <% } else { %>
          <div class="team-member-list">
            <% team.members.forEach(function(m) { %>
              <div class="team-member-row">
                <span><%= m.name %> <span class="muted">(<%= m.public_id %>)</span></span>
                <span class="badge badge-tier-<%= m.status === 'active' ? 'success' : 'warning' %>"><%= t('team.status_' + m.status) %></span>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% }) %>
  <% } %>
</main>
<%- include('../partials/bottom-nav') %>
<%- include('../partials/scripts') %>
