<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>
<main class="page">
  <p><a href="/admin" class="back-link">&larr; <%= t('admin.dashboard_title') %></a></p>
  <div class="page-header">
    <h1><%= t('admin.containers_title') %></h1>
  </div>

  <form method="get" action="/admin/containers" class="filter-form card">
    <div class="filter-grid">
      <div>
        <label for="q"><%= t('common.search') %></label>
        <input type="search" id="q" name="q" value="<%= q %>" placeholder="<%= t('admin.containers_search_placeholder') %>">
      </div>
    </div>
    <div class="filter-form-actions">
      <button type="submit" class="btn btn-primary"><%= t('common.search') %></button>
    </div>
  </form>

  <% if (containers.length === 0) { %>
    <p class="empty-state"><%= t('marketplace.no_results') %></p>
  <% } else { %>
    <div class="listing-table">
      <% containers.forEach(function(c) { %>
        <div class="card listing-row">
          <div class="listing-row-main">
            <a href="/containers/<%= c.id %>" class="listing-row-route"><%= c.origin_city %> &rarr; <%= c.destination_city %></a>
            <div class="muted"><%= c.container_number %> &middot; <%= c.owner_name %> (<%= c.owner_email %>)</div>
            <span class="badge badge-tier-<%= statusTier(c.status) %>"><%= t('status.' + c.status) %></span>
          </div>
          <div class="listing-row-actions">
            <a href="/containers/<%= c.id %>" class="btn btn-ghost btn-sm"><%= t('common.view') %></a>
            <% if (c.status !== 'closed') { %>
              <form method="post" action="/admin/containers/<%= c.id %>/close">
                <button type="submit" class="btn btn-ghost btn-sm"><%= t('marketplace.close_listing') %></button>
              </form>
            <% } %>
            <form method="post" action="/admin/containers/<%= c.id %>/delete" onsubmit="return confirm('<%= t('marketplace.confirm_delete') %>')">
              <button type="submit" class="btn btn-danger btn-sm"><%= t('common.delete') %></button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
    <%- include('../partials/pagination', { page: page, totalPages: totalPages, baseUrl: '/admin/containers', q: q }) %>
  <% } %>
</main>
<%- include('../partials/bottom-nav') %>
<%- include('../partials/scripts') %>
