<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>
<main class="page">
  <div class="page-head">
    <div>
      <h1><%= t('marketplace.browse_title') %></h1>
      <p class="page-head-sub"><%= t('home.hero_subtitle') %></p>
    </div>
    <% if (currentUser) { %>
      <div class="page-head-actions">
        <a href="/containers/new" class="btn btn-primary btn-sm"><%= t('dashboard.post_new') %></a>
      </div>
    <% } %>
  </div>

  <form method="get" action="/browse" class="filter-form card">
    <div class="filter-grid">
      <div>
        <label for="origin_country"><%= t('marketplace.filter_origin') %></label>
        <input list="countries" id="origin_country" name="origin_country" value="<%= filters.origin_country %>">
      </div>
      <div>
        <label for="origin_city"><%= t('marketplace.origin_city') %></label>
        <input type="text" id="origin_city" name="origin_city" value="<%= filters.origin_city %>">
      </div>
      <div>
        <label for="destination_country"><%= t('marketplace.filter_destination') %></label>
        <input list="countries" id="destination_country" name="destination_country" value="<%= filters.destination_country %>">
      </div>
      <div>
        <label for="destination_city"><%= t('marketplace.destination_city') %></label>
        <input type="text" id="destination_city" name="destination_city" value="<%= filters.destination_city %>">
      </div>
      <div>
        <label for="size"><%= t('marketplace.filter_size') %></label>
        <select id="size" name="size">
          <option value=""><%= t('marketplace.all_sizes') %></option>
          <% CONTAINER_SIZES.forEach(function(size) { %>
            <option value="<%= size %>" <%= filters.size === size ? 'selected' : '' %>><%= t('marketplace.size_' + size) %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="status"><%= t('marketplace.filter_status') %></label>
        <select id="status" name="status">
          <option value=""><%= t('marketplace.all_statuses') %></option>
          <% STATUSES.forEach(function(status) { %>
            <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= t('status.' + status) %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <% if (userLocation) { %>
      <input type="hidden" name="lat" value="<%= userLocation.lat %>">
      <input type="hidden" name="lng" value="<%= userLocation.lng %>">
    <% } %>
    <div class="filter-form-actions">
      <button type="submit" class="btn btn-primary"><%= t('common.search') %></button>
      <button type="button" class="btn btn-ghost" data-geolocate data-locating-label="<%= t('marketplace.locating') %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M22 12h-3M5 12H2"/></svg>
        <%= userLocation ? t('marketplace.location_active') : t('marketplace.use_my_location') %>
      </button>
    </div>
  </form>
  <datalist id="countries">
    <% COUNTRIES.forEach(function(country) { %><option value="<%= country %>"><% }) %>
  </datalist>

  <% var featuredRecommendation = (results.length === 0 && nearbyResults.length > 0) ? nearbyResults[0] : null; %>
  <% var remainingNearby = featuredRecommendation ? nearbyResults.slice(1) : nearbyResults; %>

  <% if (results.length === 0 && nearbyResults.length === 0) { %>
    <div class="card">
      <div class="empty-state">
        <span class="empty-state-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.8-4.8"/></svg>
        </span>
        <p><%= t('marketplace.no_results') %></p>
        <a href="/browse" class="btn btn-ghost btn-sm"><%= t('marketplace.all_statuses') %></a>
      </div>
    </div>
  <% } else if (results.length > 0) { %>
    <div class="container-grid">
      <% results.forEach(function(c) { %>
        <%- include('../partials/container-card', { c: c }) %>
      <% }) %>
    </div>
  <% } %>

  <% if (featuredRecommendation) { %>
    <a href="/containers/<%= featuredRecommendation.id %>" class="recommend-card">
      <span class="recommend-radar" aria-hidden="true">
        <span class="recommend-radar-ring"></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.5-7-11.5A7 7 0 0 1 19 9.5C19 14.5 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.3"/></svg>
      </span>
      <span class="recommend-body">
        <span class="recommend-eyebrow"><%= t('marketplace.recommend_badge') %></span>
        <strong class="recommend-title"><%= t('marketplace.recommend_title') %></strong>
        <span class="recommend-route"><%= featuredRecommendation.origin_city %>, <%= featuredRecommendation.origin_country %> &rarr; <%= featuredRecommendation.destination_city %>, <%= featuredRecommendation.destination_country %></span>
        <% if (featuredRecommendation.distance_km != null) { %>
          <span class="recommend-distance"><%= t('marketplace.distance_away', { km: Math.round(featuredRecommendation.distance_km) }) %></span>
        <% } %>
      </span>
      <span class="btn btn-primary btn-sm recommend-cta"><%= t('marketplace.recommend_cta') %></span>
    </a>
  <% } %>

  <% if (remainingNearby.length > 0) { %>
    <h2 class="section-heading"><%= t('marketplace.nearby_results') %></h2>
    <div class="container-grid">
      <% remainingNearby.forEach(function(c) { %>
        <%- include('../partials/container-card', { c: c }) %>
      <% }) %>
    </div>
  <% } %>
</main>
<%- include('../partials/bottom-nav') %>
<%- include('../partials/scripts') %>
