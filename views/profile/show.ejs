<%- include('../partials/head', { title: title, og: og }) %>
<%- include('../partials/header') %>
<main class="page">
  <div class="page-head">
    <div>
      <span class="shipbox-eyebrow">ShipBox</span>
      <h1><%= profileUser.name %></h1>
      <p class="page-head-sub"><%= t('profile.og_description') %></p>
    </div>
    <div class="page-head-actions">
      <% if (profileUser.rating_count > 0) { %>
        <span class="owner-rating">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.8-6.2 3.8 1.6-7L2 9.2l7.1-.6z"/></svg>
          <%= Number(profileUser.rating_avg).toFixed(1) %> <span class="muted">(<%= profileUser.rating_count %>)</span>
        </span>
      <% } %>
      <a href="/browse" class="btn btn-ghost btn-sm"><%= t('nav.browse') %></a>
      <button type="button" class="btn btn-primary btn-sm" data-share-url="<%= baseUrl %>/u/<%= profileUser.handle %>" data-share-title="<%= profileUser.name %>" data-copied-label="<%= t('common.copied') %>"><%= t('common.share') %></button>
    </div>
  </div>

  <% if (listings.length === 0) { %>
    <section class="panel">
      <div class="panel-head">
        <h2 class="panel-title"><%= t('marketplace.browse_title') %></h2>
      </div>
      <div class="empty-state">
        <span class="empty-state-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="11" rx="1.6"/><path d="M3 12.5h18M9 8v11M15 8v11"/></svg>
        </span>
        <p><%= t('profile.no_listings') %></p>
        <a href="/browse" class="btn btn-ghost btn-sm"><%= t('nav.browse') %></a>
      </div>
    </section>
  <% } else { %>
    <div class="container-grid">
      <% listings.forEach(function(c) { %>
        <%- include('../partials/container-card', { c: c }) %>
      <% }) %>
    </div>
  <% } %>
</main>
<%- include('../partials/bottom-nav') %>
<%- include('../partials/scripts') %>
