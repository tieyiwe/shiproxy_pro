<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>

<main class="page page-narrow">
  <div class="page-head">
    <div>
      <h1><%= t('packages.tracking_title') %></h1>
      <p class="page-head-sub">
        <%= pkg.origin_city %>, <%= pkg.origin_country %> &rarr; <%= pkg.destination_city %>, <%= pkg.destination_country %>
        &middot; <%= pkg.container_number %>
      </p>
    </div>
    <div class="page-head-actions">
      <span class="badge badge-tier-<%= statusTier(pkg.status) %>"><%= t('packages.status_' + pkg.status) %></span>
    </div>
  </div>

  <section class="panel">
    <div class="panel-head">
      <h2 class="panel-title">
        <span class="panel-title-icon panel-title-icon-teal" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8l-9-5-9 5v8l9 5z"/><path d="m3.3 7.5 8.7 5 8.7-5M12 12.5V21"/></svg>
        </span>
        <%= t('packages.detail_title') %>
      </h2>
    </div>
    <div class="panel-body detail-info">
      <dl>
        <dt><%= t('packages.sender_name') %></dt><dd><%= pkg.sender_name %></dd>
        <dt><%= t('packages.receiver_name') %></dt><dd><%= pkg.receiver_name %></dd>
        <% if (pkg.weight_kg) { %><dt><%= t('packages.weight_kg') %></dt><dd><%= pkg.weight_kg %> kg</dd><% } %>
      </dl>
    </div>
  </section>

  <% if (pkg.status === 'delivered') { %>
    <section class="panel">
      <div class="panel-head">
        <h2 class="panel-title">
          <span class="panel-title-icon panel-title-icon-success" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8 12.3 2.6 2.6L16 9.6"/></svg>
          </span>
          <%= t('packages.status_delivered') %>
        </h2>
      </div>
      <div class="panel-body">
        <p class="alert alert-success"><%= t('packages.already_confirmed') %></p>
        <% if (pkg.receiver_notes) { %><p class="detail-notes"><strong><%= t('packages.receiver_notes') %>:</strong> <%= pkg.receiver_notes %></p><% } %>
      </div>
    </section>
  <% } else if (pkg.status !== 'departed') { %>
    <section class="panel">
      <div class="panel-head">
        <h2 class="panel-title"><%= t('packages.confirm_title') %></h2>
      </div>
      <div class="empty-state">
        <span class="empty-state-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5.4l3.3 2"/></svg>
        </span>
        <p><%= t('packages.not_yet_arrived') %></p>
      </div>
    </section>
  <% } else { %>
    <section class="panel">
      <div class="panel-head">
        <h2 class="panel-title">
          <span class="panel-title-icon panel-title-icon-accent" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 7.5 10 18l-5.5-5.5"/></svg>
          </span>
          <%= t('packages.confirm_title') %>
        </h2>
      </div>
      <div class="panel-body confirm-card">
        <p class="muted"><%= t('packages.confirm_hint') %></p>
        <form method="post" action="/track/<%= pkg.access_token %>/confirm" class="form">
          <label for="receiver_notes"><%= t('packages.receiver_notes') %> <span class="muted">(<%= t('common.optional') %>, <%= t('packages.receiver_notes_hint') %>)</span></label>
          <textarea id="receiver_notes" name="receiver_notes" rows="2"></textarea>
          <button type="submit" class="btn btn-primary btn-lg btn-block"><%= t('packages.confirm_button') %></button>
        </form>
      </div>
    </section>
  <% } %>

  <% if (!currentUser) { %>
    <section class="panel">
      <div class="panel-head">
        <h2 class="panel-title"><%= t('packages.join_title') %></h2>
      </div>
      <div class="panel-body join-cta">
        <p class="muted"><%= t('packages.join_body') %></p>
        <a href="/signup" class="btn btn-primary btn-block"><%= t('nav.signup') %></a>
      </div>
    </section>
  <% } %>
</main>
<%- include('../partials/bottom-nav') %>
<%- include('../partials/scripts') %>
