<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>
<main class="page">
  <p><a href="/messages" class="back-link">&larr; <%= t('common.back') %></a></p>
  <h1><%= t('messages.conversation_with') %> <%= otherUser ? otherUser.name : '' %></h1>
  <p class="muted"><%= t('messages.about_listing') %>: <a href="/containers/<%= conversation.container_id %>"><%= conversation.origin_city %> &rarr; <%= conversation.destination_city %> (<%= conversation.container_number %>)</a></p>

  <div class="thread">
    <% messages.forEach(function(m) { %>
      <div class="message-bubble <%= m.sender_id === currentUser.id ? 'mine' : 'theirs' %>">
        <p><%= m.body %></p>
        <time><%= new Date(m.created_at).toLocaleString(lang) %></time>
      </div>
    <% }) %>
  </div>

  <form method="post" action="/messages/<%= conversation.id %>/reply" class="form reply-form">
    <textarea name="body" rows="2" placeholder="<%= t('messages.reply_placeholder') %>" required></textarea>
    <button type="submit" class="btn btn-primary"><%= t('messages.send') %></button>
  </form>
</main>
<%- include('../partials/bottom-nav') %>
<%- include('../partials/scripts') %>
