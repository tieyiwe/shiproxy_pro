<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>
<main class="page">
  <div class="page-header">
    <h1><%= t('dashboard.my_listings') %></h1>
    <a href="/containers/new" class="btn btn-primary btn-sm"><%= t('dashboard.post_new') %></a>
  </div>
  <p class="muted account-id"><%= t('dashboard.account_id') %>: <strong><%= currentUser.public_id %></strong></p>
  <form method="post" action="/logout" class="mobile-only-inline logout-inline">
    <button type="submit" class="link-button"><%= t('nav.logout') %></button>
  </form>

  <% if (containers.length === 0) { %>
    <p class="empty-state"><%= t('dashboard.no_listings') %></p>
  <% } else { %>
    <div class="listing-table">
      <% containers.forEach(function(c) { %>
        <div class="card listing-row">
          <div class="listing-row-main">
            <a href="/containers/<%= c.id %>" class="listing-row-route"><%= c.origin_city %> &rarr; <%= c.destination_city %></a>
            <div class="muted"><%= c.container_number %> &middot; <%= t('marketplace.size_' + c.size) %></div>
            <span class="badge badge-tier-<%= statusTier(c.status) %>"><%= t('status.' + c.status) %></span>
            <% if (c.featured) { %><span class="badge badge-featured"><%= t('marketplace.featured_badge') %></span><% } %>
          </div>
          <div class="listing-row-actions">
            <a href="/containers/<%= c.id %>" class="btn btn-ghost btn-sm"><%= t('common.view') %></a>
            <a href="/containers/<%= c.id %>/edit" class="btn btn-ghost btn-sm"><%= t('common.edit') %></a>
            <a href="/containers/<%= c.id %>/packages" class="btn btn-ghost btn-sm"><%= t('packages.list_title') %></a>
            <a href="<%= c.tracking_url %>" target="_blank" rel="noopener" class="btn btn-ghost btn-sm"><%= t('marketplace.track_shipment') %></a>
            <% if (c.status === 'closed') { %>
              <form method="post" action="/containers/<%= c.id %>/reopen"><button type="submit" class="btn btn-ghost btn-sm"><%= t('marketplace.reopen_listing') %></button></form>
              <% if (!c.departed_at) { %>
                <form method="post" action="/containers/<%= c.id %>/depart"><button type="submit" class="btn btn-ghost btn-sm"><%= t('packages.mark_departed') %></button></form>
              <% } %>
            <% } else { %>
              <form method="post" action="/containers/<%= c.id %>/close"><button type="submit" class="btn btn-ghost btn-sm"><%= t('marketplace.close_listing') %></button></form>
            <% } %>
            <% if (c.featured) { %>
              <form method="post" action="/containers/<%= c.id %>/unfeature"><button type="submit" class="btn btn-ghost btn-sm"><%= t('marketplace.unfeature_listing') %></button></form>
            <% } else { %>
              <form method="post" action="/containers/<%= c.id %>/feature"><button type="submit" class="btn btn-ghost btn-sm"><%= t('marketplace.feature_listing') %></button></form>
            <% } %>
            <form method="post" action="/containers/<%= c.id %>/delete" onsubmit="return confirm('<%= t('marketplace.confirm_delete') %>')">
              <button type="submit" class="btn btn-danger btn-sm"><%= t('common.delete') %></button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <p><a href="/messages" class="btn btn-ghost"><%= t('nav.messages') %></a></p>
</main>
<%- include('../partials/bottom-nav') %>
<%- include('../partials/scripts') %>
