<%- include('../partials/head', { title: t('auth.signup_title') }) %>
<%- include('../partials/header') %>
<main class="page auth-page">
  <div class="auth-intro">
    <span class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="11" rx="1.6"/><path d="M3 12.5h18M9 8v11M15 8v11"/><path d="M6.5 8 9 4h6l2.5 4"/></svg>
    </span>
    <h1><%= t('auth.signup_title') %></h1>
    <p><%= t('home.hero_subtitle') %></p>
  </div>
  <div class="card auth-card">
    <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
    <form method="post" action="/signup" class="form">
      <label for="name"><%= t('auth.name') %></label>
      <input type="text" id="name" name="name" value="<%= values.name %>" required>

      <label for="email"><%= t('auth.email') %></label>
      <input type="email" id="email" name="email" value="<%= values.email %>" required>

      <label for="password"><%= t('auth.password') %></label>
      <input type="password" id="password" name="password" minlength="8" required>
      <p class="field-hint"><%= t('auth.password_hint') %></p>

      <label><%= t('auth.account_type') %></label>
      <div class="account-type-options">
        <label class="account-type-choice">
          <input type="radio" id="account_type_expediter" name="account_type" value="expediter" <%= (values.account_type || 'expediter') === 'expediter' ? 'checked' : '' %>>
          <%= t('auth.account_type_expediter') %>
        </label>
        <label class="account-type-choice">
          <input type="radio" id="account_type_company" name="account_type" value="shipping_company" <%= values.account_type === 'shipping_company' ? 'checked' : '' %>>
          <%= t('auth.account_type_shipping_company') %>
        </label>
        <label class="account-type-choice">
          <input type="radio" id="account_type_solo" name="account_type" value="independent_shipper" <%= values.account_type === 'independent_shipper' ? 'checked' : '' %>>
          <%= t('auth.account_type_independent_shipper') %>
        </label>
        <div class="account-type-business-fields form-row">
          <div>
            <label for="business_name"><%= t('auth.business_name') %></label>
            <input type="text" id="business_name" name="business_name" value="<%= values.business_name || '' %>">
          </div>
          <div>
            <label for="business_contact_name"><%= t('auth.business_contact_name') %> <span class="muted">(<%= t('common.optional') %>)</span></label>
            <input type="text" id="business_contact_name" name="business_contact_name" value="<%= values.business_contact_name || '' %>">
          </div>
          <div>
            <label for="business_phone"><%= t('auth.business_phone') %> <span class="muted">(<%= t('common.optional') %>)</span></label>
            <input type="tel" id="business_phone" name="business_phone" value="<%= values.business_phone || '' %>">
          </div>
          <div>
            <label for="business_location"><%= t('auth.business_location') %> <span class="muted">(<%= t('common.optional') %>)</span></label>
            <input type="text" id="business_location" name="business_location" value="<%= values.business_location || '' %>">
          </div>
        </div>
      </div>

      <label for="preferred_lang"><%= t('auth.preferred_lang') %></label>
      <select id="preferred_lang" name="preferred_lang">
        <% languages.forEach(function(code) { %>
          <option value="<%= code %>" <%= code === lang ? 'selected' : '' %>><%= t('auth.lang_' + code) %></option>
        <% }) %>
      </select>
      <p class="field-hint"><%= t('auth.preferred_lang_hint') %></p>

      <p class="field-hint signup-consent"><%- t('legal.signup_consent', {
        terms: `<a href="/terms" target="_blank">${t('legal.terms_title')}</a>`,
        privacy: `<a href="/privacy" target="_blank">${t('legal.privacy_title')}</a>`,
      }) %></p>

      <button type="submit" class="btn btn-primary btn-block"><%= t('auth.signup_button') %></button>
    </form>
    <p class="auth-switch"><%= t('auth.already_account') %> <a href="/login"><%= t('auth.login_title') %></a></p>
  </div>
</main>
<%- include('../partials/bottom-nav') %>
<%- include('../partials/scripts') %>
