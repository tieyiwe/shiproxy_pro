<%- include('../partials/head', { title: t('auth.login_title') }) %>
<%- include('../partials/header') %>
<main class="page auth-page">
  <div class="auth-intro">
    <img src="/favicon.svg" alt="" class="brand-tile" width="52" height="52">
    <h1><%= t('auth.login_title') %></h1>
    <p><%= t('home.hero_subtitle') %></p>
  </div>
  <div class="card auth-card">
    <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
    <form method="post" action="/login" class="form">
      <label for="email"><%= t('auth.email') %></label>
      <input type="email" id="email" name="email" value="<%= values.email %>" required>

      <label for="password"><%= t('auth.password') %></label>
      <input type="password" id="password" name="password" required>

      <button type="submit" class="btn btn-primary btn-block"><%= t('auth.login_button') %></button>
    </form>
    <p class="auth-switch"><%= t('auth.no_account') %> <a href="/signup"><%= t('auth.signup_title') %></a></p>
  </div>
</main>
<%- include('../partials/bottom-nav') %>
<%- include('../partials/scripts') %>
