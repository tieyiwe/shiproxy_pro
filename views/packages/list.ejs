<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>
<main class="page page-narrow">
  <p><a href="/containers/<%= container.id %>" class="back-link">&larr; <%= container.origin_city %> &rarr; <%= container.destination_city %></a></p>
  <div class="page-head">
    <div>
      <h1><%= t('packages.list_title') %></h1>
      <p class="page-head-sub">
        <%= container.container_number %>
        &middot; <%= t('marketplace.size_' + container.size) %>
        &middot; <span class="badge badge-tier-<%= statusTier(container.status) %>"><%= t('status.' + container.status) %></span>
      </p>
    </div>
    <div class="page-head-actions">
      <a href="/containers/<%= container.id %>" class="btn btn-ghost btn-sm"><%= t('common.view') %></a>
      <a href="/containers/<%= container.id %>/packages/new" class="btn btn-primary btn-sm"><%= t('packages.add_title') %></a>
    </div>
  </div>

  <section class="panel">
    <div class="panel-head">
      <h2 class="panel-title">
        <%= t('packages.list_title') %>
        <% if (packages.length > 0) { %><span class="count-pill"><%= packages.length %></span><% } %>
      </h2>
      <a href="/containers/<%= container.id %>/packages/new" class="btn btn-ghost btn-sm"><%= t('packages.add_title') %></a>
    </div>
    <% if (packages.length === 0) { %>
      <div class="empty-state">
        <span class="empty-state-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8l-9-5-9 5v8l9 5z"/><path d="m3.3 7.5 8.7 5 8.7-5M12 12.5V21"/></svg>
        </span>
        <p><%= t('packages.no_packages') %></p>
        <p class="muted"><%= t('packages.tracking_link_hint') %></p>
        <a href="/containers/<%= container.id %>/packages/new" class="btn btn-primary btn-sm"><%= t('packages.add_title') %></a>
      </div>
    <% } else { %>
      <div class="data-list">
        <% packages.forEach(function(p) { %>
          <a href="/containers/<%= container.id %>/packages/<%= p.id %>" class="data-row">
            <span class="data-row-main">
              <span class="data-row-title"><%= p.sender_name %> &rarr; <%= p.receiver_name %></span>
              <span class="data-row-meta">
                <%= p.sender_contact %><% if (p.weight_kg) { %> &middot; <%= p.weight_kg %> kg<% } %>
              </span>
              <span class="data-row-badges">
                <span class="badge badge-tier-<%= statusTier(p.status) %>"><%= t('packages.status_' + p.status) %></span>
                <% if (p.amount_charged) { %>
                  <span class="badge badge-tier-neutral"><%= p.amount_charged %> <%= p.amount_currency %></span>
                <% } %>
              </span>
            </span>
            <span class="data-row-actions">
              <span class="muted" aria-hidden="true">&rsaquo;</span>
            </span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>
<%- include('../partials/bottom-nav') %>
<%- include('../partials/scripts') %>
