<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header') %>
<main class="page">
  <p><a href="/containers/<%= container.id %>/packages" class="back-link">&larr; <%= t('packages.list_title') %></a></p>
  <div class="detail-header">
    <h1><%= pkg.sender_name %> &rarr; <%= pkg.receiver_name %></h1>
    <div class="detail-badges">
      <span class="badge badge-tier-<%= statusTier(pkg.status) %>"><%= t('packages.status_' + pkg.status) %></span>
    </div>
  </div>

  <% if (photos.length > 0) { %>
    <div class="detail-gallery">
      <% photos.forEach(function(p) { %>
        <img src="/uploads/packages/<%= p.file_path %>" alt="">
      <% }) %>
    </div>
  <% } %>

  <div class="card detail-info">
    <dl>
      <dt><%= t('packages.sender_contact') %></dt><dd><%= pkg.sender_contact %></dd>
      <% if (pkg.sender_email) { %><dt><%= t('packages.sender_email') %></dt><dd><%= pkg.sender_email %></dd><% } %>
      <% if (pkg.weight_kg) { %><dt><%= t('packages.weight_kg') %></dt><dd><%= pkg.weight_kg %> kg</dd><% } %>
      <% if (pkg.details) { %><dt><%= t('packages.details') %></dt><dd><%= pkg.details %></dd><% } %>
      <% if (pkg.amount_charged) { %>
        <dt><%= t('packages.transaction_title') %></dt>
        <dd><%= pkg.amount_charged %> <%= pkg.amount_currency %><% if (pkg.payment_note) { %> &mdash; <%= pkg.payment_note %><% } %></dd>
      <% } %>
      <% if (pkg.receiver_confirmed_at) { %>
        <dt><%= t('packages.confirmed_at') %></dt><dd><%= new Date(pkg.receiver_confirmed_at).toLocaleString(lang) %></dd>
        <% if (pkg.receiver_notes) { %><dt><%= t('packages.receiver_notes') %></dt><dd><%= pkg.receiver_notes %></dd><% } %>
      <% } %>
    </dl>
  </div>

  <div class="card package-qr-card">
    <h2><%= t('packages.tracking_link_title') %></h2>
    <p class="muted"><%= t('packages.tracking_link_hint') %></p>
    <img src="<%= qrSrc %>" alt="QR" class="package-qr">
    <p class="tracking-url-row">
      <input type="text" readonly value="<%= trackUrl %>" onclick="this.select()">
      <button type="button" class="btn btn-ghost btn-sm" data-share-url="<%= trackUrl %>" data-share-title="ShipRoxy" data-copied-label="<%= t('common.copied') %>"><%= t('common.share') %></button>
    </p>
  </div>

  <form method="post" action="/containers/<%= container.id %>/packages/<%= pkg.id %>/delete" onsubmit="return confirm('<%= t('marketplace.confirm_delete') %>')">
    <button type="submit" class="btn btn-danger btn-sm"><%= t('common.delete') %></button>
  </form>
</main>
<%- include('../partials/bottom-nav') %>
<%- include('../partials/scripts') %>
